{
  "name": "notekeeper-rc",
  "private": true,
  "version": "0.0.0",
  "description": "Offline-first note-taking PWA that organizes notes into notebooks.",
  "license": "MIT",
  "author": "Bilal Ben",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/billalben/notekeeper-rc.git"
  },
  "homepage": "https://github.com/billalben/notekeeper-rc#readme",
  "bugs": {
    "url": "https://github.com/billalben/notekeeper-rc/issues"
  },
  "keywords": [
    "notes",
    "note-taking",
    "notebooks",
    "markdown",
    "pwa",
    "react",
    "typescript",
    "vite",
    "offline-first"
  ],
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "oxlint",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "knip": "knip",
    "knip:report": "knip --no-progress --reporter markdown --no-exit-code > knip-report.md",
    "preview": "vite preview",
    "generate:pwa-assets": "pwa-assets-generator",
    "prepare": "husky"
  },
  "dependencies": {
    "fuse.js": "^7.5.0",
    "hast-util-to-text": "^4.0.2",
    "highlight.js": "~11.11.2",
    "i18next": "^26.4.2",
    "lowlight": "^3.3.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-hotkeys-hook": "^5.3.3",
    "react-i18next": "^17.0.14",
    "react-markdown": "^10.1.0",
    "rehype-sanitize": "^6.0.0",
    "remark-gfm": "^4.0.1",
    "unist-util-visit": "^5.1.0",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@types/hast": "^3.0.5",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vite-pwa/assets-generator": "^1.0.4",
    "@vitejs/plugin-react": "^6.1.1",
    "husky": "^9.1.7",
    "knip": "^6.37.0",
    "lint-staged": "^17.5.1",
    "oxlint": "^1.81.0",
    "prettier": "^3.9.8",
    "typescript": "~6.0.2",
    "vite": "^8.3.0",
    "vite-plugin-pwa": "^1.3.0",
    "workbox-window": "^7.4.1"
  }
}
